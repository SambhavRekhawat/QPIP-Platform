# ================================================================
# .env  —  Quantitative Portfolio Intelligence Platform
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ================================================================

# ── PostgreSQL Database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quant_platform
DB_USER=postgres
DB_PASSWORD=5432

# ── API Keys (optional but recommended) ─────────────────────────
# Get a free key at https://newsapi.org  (500 req/day on free tier)
NEWS_API_KEY=34113e24a41745d0acc9a71be7adbf4e

# Alpha Vantage (optional, not required for core features)
ALPHA_VANTAGE_KEY=your_alphavantage_key_here

# ── App Settings ────────────────────────────────────────────────
LOG_LEVEL=INFO
